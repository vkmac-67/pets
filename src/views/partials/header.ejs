<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= title %> | CRUD Mascotas</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="/css/styles.css">
  </head>
  <body class="min-h-screen bg-slate-50 text-slate-900">
    <header class="border-b border-slate-200 bg-white">
      <nav class="mx-auto flex max-w-6xl items-center justify-between px-4 py-4">
        <a href="/mascotas" class="text-xl font-bold text-teal-700">CRUD Mascotas</a>
        <div class="flex gap-2">
          <a
            href="/mascotas"
            class="rounded-md px-3 py-2 text-sm font-semibold <%= currentPath.startsWith('/mascotas') ? 'bg-teal-700 text-white' : 'text-slate-700 hover:bg-slate-100' %>"
          >
            Mascotas
          </a>
          <a
            href="/duenos"
            class="rounded-md px-3 py-2 text-sm font-semibold <%= currentPath.startsWith('/duenos') ? 'bg-teal-700 text-white' : 'text-slate-700 hover:bg-slate-100' %>"
          >
            Duenos
          </a>
        </div>
      </nav>
    </header>
    <main class="mx-auto max-w-6xl px-4 py-8">
