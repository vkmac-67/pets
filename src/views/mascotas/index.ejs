<%- include('../partials/header') %>

<section class="mb-6 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
  <div>
    <h1 class="text-3xl font-bold">Mascotas</h1>
    <p class="mt-1 text-slate-600">Listado con foto, especie y dueno asociado.</p>
  </div>
  <a href="/mascotas/crear" class="inline-flex items-center justify-center rounded-md bg-teal-700 px-4 py-2 font-semibold text-white hover:bg-teal-800">
    Nueva mascota
  </a>
</section>

<div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
  <% if (mascotas.length) { %>
    <% mascotas.forEach(mascota => { %>
      <article class="overflow-hidden rounded-md border border-slate-200 bg-white shadow-sm">
        <div class="aspect-[4/3] bg-slate-100">
          <% if (mascota.foto) { %>
            <img src="/uploads/<%= mascota.foto %>" alt="Foto de <%= mascota.nombre %>" class="h-full w-full object-cover">
          <% } else { %>
            <div class="flex h-full items-center justify-center text-slate-400">Sin foto</div>
          <% } %>
        </div>
        <div class="p-4">
          <div class="flex items-start justify-between gap-4">
            <div>
              <h2 class="text-xl font-bold"><%= mascota.nombre %></h2>
              <p class="text-sm text-slate-600"><%= mascota.especie %></p>
            </div>
            <span class="rounded-md bg-slate-100 px-2 py-1 text-xs font-semibold text-slate-700">#<%= mascota.id_mascota %></span>
          </div>

          <p class="mt-3 text-sm">
            <span class="font-semibold text-slate-700">Dueno:</span>
            <%= mascota.dueno %>
          </p>

          <div class="mt-4 flex gap-2">
            <a href="/mascotas/<%= mascota.id_mascota %>/editar" class="flex-1 rounded-md border border-slate-300 px-3 py-2 text-center text-sm font-semibold text-slate-700 hover:bg-slate-100">Editar</a>
            <form action="/mascotas/<%= mascota.id_mascota %>?_method=DELETE" method="POST" class="flex-1" onsubmit="return confirm('Seguro que deseas eliminar esta mascota?')">
              <button class="w-full rounded-md bg-red-600 px-3 py-2 text-sm font-semibold text-white hover:bg-red-700" type="submit">Eliminar</button>
            </form>
          </div>
        </div>
      </article>
    <% }) %>
  <% } else { %>
    <div class="rounded-md border border-dashed border-slate-300 bg-white px-4 py-10 text-center text-slate-500 sm:col-span-2 lg:col-span-3">
      No hay mascotas registradas.
    </div>
  <% } %>
</div>

<%- include('../partials/footer') %>
