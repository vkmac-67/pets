<%- include('../partials/header') %>

<section class="mx-auto max-w-2xl">
  <div class="mb-6">
    <a href="/mascotas" class="text-sm font-semibold text-teal-700 hover:text-teal-800">Volver</a>
    <h1 class="mt-2 text-3xl font-bold"><%= title %></h1>
  </div>

  <%- include('../partials/errors') %>

  <% if (!duenos.length) { %>
    <div class="mb-5 rounded-md border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-800">
      Primero registra al menos un dueno para poder crear mascotas.
    </div>
  <% } %>

  <form action="<%= action %>" method="<%= method %>" enctype="multipart/form-data" class="rounded-md border border-slate-200 bg-white p-6 shadow-sm">
    <input type="hidden" name="foto_actual" value="<%= mascota.foto || '' %>">

    <div class="grid gap-5">
      <label class="grid gap-2">
        <span class="text-sm font-semibold text-slate-700">Nombre</span>
        <input
          type="text"
          name="nombre"
          value="<%= mascota.nombre || '' %>"
          class="rounded-md border border-slate-300 px-3 py-2 outline-none focus:border-teal-600 focus:ring-2 focus:ring-teal-100"
          required
        >
      </label>

      <label class="grid gap-2">
        <span class="text-sm font-semibold text-slate-700">Especie</span>
        <input
          type="text"
          name="especie"
          value="<%= mascota.especie || '' %>"
          placeholder="Perro, gato, conejo..."
          class="rounded-md border border-slate-300 px-3 py-2 outline-none focus:border-teal-600 focus:ring-2 focus:ring-teal-100"
          required
        >
      </label>

      <label class="grid gap-2">
        <span class="text-sm font-semibold text-slate-700">Dueno</span>
        <select
          name="id_dueno"
          class="rounded-md border border-slate-300 px-3 py-2 outline-none focus:border-teal-600 focus:ring-2 focus:ring-teal-100"
          required
        >
          <option value="">Seleccionar dueno</option>
          <% duenos.forEach(dueno => { %>
            <option value="<%= dueno.id_dueno %>" <%= String(mascota.id_dueno || '') === String(dueno.id_dueno) ? 'selected' : '' %>>
              <%= dueno.nombre %>
            </option>
          <% }) %>
        </select>
      </label>

      <label class="grid gap-2">
        <span class="text-sm font-semibold text-slate-700">Foto</span>
        <input
          type="file"
          name="foto"
          accept="image/jpeg,image/png,image/webp,image/gif"
          class="rounded-md border border-slate-300 px-3 py-2 file:mr-4 file:rounded-md file:border-0 file:bg-teal-700 file:px-3 file:py-2 file:font-semibold file:text-white"
          <%= mascota.id_mascota ? '' : 'required' %>
        >
        <% if (mascota.foto) { %>
          <div class="mt-2 flex items-center gap-3">
            <img src="/uploads/<%= mascota.foto %>" alt="Foto actual" class="h-20 w-20 rounded-md object-cover">
            <span class="text-sm text-slate-500">Sube otra imagen para reemplazar la actual.</span>
          </div>
        <% } %>
      </label>
    </div>

    <div class="mt-6 flex justify-end gap-3">
      <a href="/mascotas" class="rounded-md border border-slate-300 px-4 py-2 font-semibold text-slate-700 hover:bg-slate-100">Cancelar</a>
      <button type="submit" class="rounded-md bg-teal-700 px-4 py-2 font-semibold text-white hover:bg-teal-800" <%= duenos.length ? '' : 'disabled' %>>
        Guardar
      </button>
    </div>
  </form>
</section>

<%- include('../partials/footer') %>
