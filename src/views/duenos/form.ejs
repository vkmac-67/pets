<%- include('../partials/header') %>

<section class="mx-auto max-w-2xl">
  <div class="mb-6">
    <a href="/duenos" class="text-sm font-semibold text-teal-700 hover:text-teal-800">Volver</a>
    <h1 class="mt-2 text-3xl font-bold"><%= title %></h1>
  </div>

  <%- include('../partials/errors') %>

  <form action="<%= action %>" method="<%= method %>" class="rounded-md border border-slate-200 bg-white p-6 shadow-sm">
    <div class="grid gap-5">
      <label class="grid gap-2">
        <span class="text-sm font-semibold text-slate-700">Nombre</span>
        <input
          type="text"
          name="nombre"
          value="<%= dueno.nombre || '' %>"
          class="rounded-md border border-slate-300 px-3 py-2 outline-none focus:border-teal-600 focus:ring-2 focus:ring-teal-100"
          required
        >
      </label>

      <label class="grid gap-2">
        <span class="text-sm font-semibold text-slate-700">Telefono</span>
        <input
          type="text"
          name="telefono"
          value="<%= dueno.telefono || '' %>"
          class="rounded-md border border-slate-300 px-3 py-2 outline-none focus:border-teal-600 focus:ring-2 focus:ring-teal-100"
          required
        >
      </label>
    </div>

    <div class="mt-6 flex justify-end gap-3">
      <a href="/duenos" class="rounded-md border border-slate-300 px-4 py-2 font-semibold text-slate-700 hover:bg-slate-100">Cancelar</a>
      <button type="submit" class="rounded-md bg-teal-700 px-4 py-2 font-semibold text-white hover:bg-teal-800">Guardar</button>
    </div>
  </form>
</section>

<%- include('../partials/footer') %>
